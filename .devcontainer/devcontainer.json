{
  "name": "Substrate Node template",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "context": "..",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false
    }
  },
  "mounts": [
    "source=knx-subtensor-cargo-target,target=/cargo-target,type=volume"
  ],
  "containerEnv": {
    "CARGO_TARGET_DIR": "/cargo-target"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "lldb.executable": "/usr/bin/lldb",
        "rust-analyzer.check.run": "never",
        "rust-analyzer.checkOnSave": false,
        "rust-analyzer.cargo.targetDir": "/cargo-target/rust-analyzer",
        "rust-analyzer.cargo.extraEnv": {
          "SKIP_WASM_BUILD": "1"
        }
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "bungcip.better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "forwardPorts": [
    3000,
    9944,
    30000,
    30001,
    30002,
    30003,
    30004
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /cargo-target && sudo apt-get update && sudo apt-get install -y protobuf-compiler clang libclang-dev pkg-config libssl-dev && rustup toolchain install nightly && rustup target add wasm32-unknown-unknown --toolchain nightly && bash .devcontainer/setup-ssh-konnex.sh",
  "menuActions": [
    {
      "id": "polkadotjs",
      "label": "Open PolkadotJS Apps",
      "type": "external-preview",
      "args": ["https://polkadot.js.org/apps/?rpc=wss%3A%2F%2F/$HOST/wss"]
    }
  ]
}
